{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yurd-rayon-reytinqi",
  "main": "worker.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yurd-votes",
      "database_id": "35d7bc65-a3c1-48e8-bcef-2eae72dc22a7",
      "migrations_dir": "migrations"
    }
  ]
}

